# 待办清单服务端配置示例。复制为 .env 或直接设置环境变量（前缀 TODO_SERVER_）。

# 必填：JWT 签名密钥，至少 32 字节随机串
TODO_SERVER_JWT_SECRET=replace-with-at-least-32-random-bytes

# SQLite 数据库文件（目录会自动创建）
TODO_SERVER_DB_PATH=./data/server.sqlite3

# /v1/admin/backup 令牌；留空则关闭该接口
TODO_SERVER_ADMIN_TOKEN=

# 令牌有效期
TODO_SERVER_ACCESS_TTL_MINUTES=30
TODO_SERVER_REFRESH_TTL_DAYS=30

# 同步与请求限制
TODO_SERVER_MAX_OPS_PER_PUSH=500
TODO_SERVER_MAX_BODY_BYTES=1048576
TODO_SERVER_HLC_MAX_FUTURE_MS=300000

# 自动快照间隔（条 op）；0 关闭
TODO_SERVER_SNAPSHOT_EVERY_OPS=500
TODO_SERVER_RESTORE_MAX_OPS=5000

# 注册默认工作区名
TODO_SERVER_DEFAULT_WORKSPACE_NAME=我的空间

# 备份目录
TODO_SERVER_BACKUP_DIR=./data/backups

# 鉴权接口限流（每分钟每 IP），0 关闭
TODO_SERVER_AUTH_RATE_LIMIT=10

# 日志级别
TODO_SERVER_LOG_LEVEL=info

# 便捷启动用；正式部署请用 uvicorn 命令
TODO_SERVER_BIND_HOST=127.0.0.1
TODO_SERVER_PORT=8000
