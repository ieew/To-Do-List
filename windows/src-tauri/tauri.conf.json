{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "待办清单",
  "version": "0.1.0",
  "identifier": "com.todo.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "待办清单",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#F8FAFC",
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
