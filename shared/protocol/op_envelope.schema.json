{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo.local/protocol/op_envelope.schema.json",
  "title": "OpEnvelope",
  "description": "待办清单同步 op 信封。所有字段必填（source_meta 除外），未知字段一律拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op_id",
    "workspace_id",
    "entity_type",
    "entity_id",
    "actor_id",
    "device_id",
    "operation",
    "field",
    "value",
    "hlc",
    "source"
  ],
  "properties": {
    "op_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "entity_type": {
      "enum": ["workspace", "list", "tag", "task", "membership", "user"]
    },
    "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "operation": { "enum": ["set", "add", "remove"] },
    "field": { "type": "string", "minLength": 1, "maxLength": 128 },
    "value": {},
    "hlc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_ms", "counter", "node_id"],
      "properties": {
        "physical_ms": { "type": "integer", "minimum": 0 },
        "counter": { "type": "integer", "minimum": 0 },
        "node_id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "source": { "enum": ["human", "ai", "import", "system"] },
    "source_meta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["model", "prompt_hash"],
      "properties": {
        "model": { "type": ["string", "null"], "maxLength": 128 },
        "prompt_hash": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  }
}
