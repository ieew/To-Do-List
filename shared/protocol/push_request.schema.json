{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo.local/protocol/push_request.schema.json",
  "title": "PushRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "ops"],
  "properties": {
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "op_envelope.schema.json" }
    }
  }
}
